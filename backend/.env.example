# ---------------------------------------------------------------------------
# F1 — copy this file to `.env` and paste YOUR OWN keys.
#   Windows:  copy .env.example .env
# `.env` is git-ignored. NEVER commit it. Use your own keys, not a shared one —
# the free rate limits are counted per account.
# ---------------------------------------------------------------------------

# REQUIRED — the key your class issued for the LiteLLM proxy (starts with sk-).
GEMINI_API_KEY=paste-your-proxy-key-here

# All Gemini traffic is routed through the class proxy rather than to Google.
# /v1 is its OpenAI-compatible surface; /gemini is the native Gemini surface.
PROXY_BASE_URL=https://saidazam-litellm-proxy.hf.space

# The proxy exposes exactly three model names. Do not invent others — anything
# else returns 404. smoke_test.py asserts these three are what is configured.
#   gemini-flash-lite : high volume — the 4 agents, answer generation, judging
#   gemini-flash      : supervisor + critic (routing and verification)
#   gemini-embedding  : document store + long-term memory
LLM_MODEL=gemini-flash-lite
REASONING_MODEL=gemini-flash
EMBEDDING_MODEL=gemini-embedding

# Must match what the embedding endpoint actually returns, or every Qdrant
# insert fails. verify_key.py prints the real number if this is wrong.
EMBEDDING_DIM=3072

# OPTIONAL — F4 web agent. Free 1,000 searches/month: https://tavily.com
# Leave blank and the web agent skips itself gracefully (still scores F4).
TAVILY_API_KEY=

# OPTIONAL — F12 tracing. Free tier: https://cloud.langfuse.com
# Leave blank and tracing is silently disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local paths (defaults are fine) ---
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents
MEMORY_COLLECTION=long_term_memory
SQLITE_URI=sqlite:///data/company.db
DOCS_DIR=./data/docs

# --- Safety limits (F6, F9) ---
CODE_TIMEOUT_SECONDS=10
MAX_GRAPH_STEPS=12
MAX_REVISIONS=2
